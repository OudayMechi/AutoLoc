      "name": "Agences",
      "item": [
        {
          "name": "Créer une agence",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Agence Postman\",\n  \"ville\": \"Tunis\",\n  \"adresse\": \"10 avenue de la République\",\n  \"telephone\": \"71234567\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/agences",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agences"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Création agence: HTTP 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('agenceId', pm.response.json().idAgence);"
                ]
              }
            }
          ]
